# =========================================================
# RapidAPI / Market Evaluation Settings
# =========================================================

# Provider selection
MARKET_DATA_PROVIDER=mock
# allowed: mock, rapidapi_completed

# RapidAPI credentials (Required if MARKET_DATA_PROVIDER=rapidapi_completed)
RAPIDAPI_KEY=
RAPIDAPI_HOST=ebay-average-selling-price.p.rapidapi.com

# Market evaluation behavior
MARKET_EVAL_USE_COMPLETED_DATA=true
MARKET_EVAL_PROVIDER_TIMEOUT_SECONDS=20
MARKET_EVAL_ENABLE_FIXTURE_MODE=true

# Optional behavior flags
MARKET_EVAL_SAVE_RAW_PROVIDER_RESPONSE=false
MARKET_EVAL_FAIL_ON_PROVIDER_ERROR=false
MARKET_EVAL_MIN_COMPARABLE_COUNT=3
MARKET_EVAL_MAX_RESULTS=50
MARKET_EVAL_OUTLIER_TRIM_ENABLED=true

# Logging / debugging
MARKET_EVAL_LOG_LEVEL=INFO

# Environment / guard
APP_ENV=development
ENVIRONMENT_TYPE=dev

# Admin / operations policy (optional)
ADMIN_WEB_READ_ONLY=true

# =========================================================
# Profitability Scoring Settings (Phase E)
# =========================================================
PROFITABILITY_ENABLED=true
PROFITABILITY_MIN_LAUNCH_PROFIT=3000.0
PROFITABILITY_MIN_LAUNCH_MARGIN=0.18
PROFITABILITY_MIN_LAUNCH_ROI=0.20
PROFITABILITY_MIN_REVIEW_PROFIT=1500.0
PROFITABILITY_REJECT_CONFIDENCE_THRESHOLD=0.40

PROFITABILITY_DEFAULT_MARKETPLACE_FEE_RATE=0.15
PROFITABILITY_DEFAULT_FIXED_MARKETPLACE_FEE=30.0
PROFITABILITY_DEFAULT_PAYMENT_FEE_RATE=0.04
PROFITABILITY_DEFAULT_FIXED_PAYMENT_FEE=40.0
PROFITABILITY_DEFAULT_PACKAGING_COST=200.0
PROFITABILITY_DEFAULT_HANDLING_COST=300.0
PROFITABILITY_DEFAULT_OUTBOUND_SHIPPING=2000.0

